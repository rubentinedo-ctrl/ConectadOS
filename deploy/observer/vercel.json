{
  "version": 2,
  "regions": ["iad1"],
  "functions": {"api/*.mjs": {"maxDuration": 180}},
  "crons": [{"path": "/api/check", "schedule": "*/5 * * * *"}],
  "headers": [{"source": "/(.*)", "headers": [{"key": "Cache-Control", "value": "private, no-store"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}]
}
