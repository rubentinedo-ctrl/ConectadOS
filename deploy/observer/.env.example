# Cada instalación genera sus propias claves; no reutilizar tokens de proveedores.
OBSERVER_ENABLED=0
OBSERVER_TARGETS=[{"id":"panel","url":"https://panel.example.com"}]
OBSERVER_INTERVAL_SECONDS=300
# Claves aleatorias independientes, al menos 32 caracteres. Nunca en una URL.
CRON_SECRET=
OBSERVER_REPORT_SECRET=
# Conexión OIDC del almacén privado exclusivo del observador en Vercel.
BLOB_STORE_ID=
